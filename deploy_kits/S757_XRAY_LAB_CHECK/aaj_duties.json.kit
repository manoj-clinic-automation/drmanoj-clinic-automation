  {
   "id": "bhati.physio_register",
   "person": "bhati",
   "kind": "sql",
   "group": "open",
   "allowed_days": 1,
   "hi": "Physio slips register mein likhiye -- {since} ki slips reception ke hisaab se nahin mil rahi",
   "how_hi": "Button us din ka Physio register kholta hai. Us din ki har slip Cash / UPI ke saath likhiye; galat entry 'Galat entry hatao' se hataiye. Aapka Cash aur UPI reception ke likhe se milte hi yeh line apne aap hat jaayegi.",
   "en": "Bhati: physiotherapy slips of {since} not entered in his register, or not agreeing with reception",
   "tile": "Physiotherapy",
   "door": "/finance/physio/book",
   "sql": "SELECT COUNT(*) AS n, MIN(r.business_date) AS since FROM clinic_physio_day r WHERE r.business_date >= COALESCE((SELECT value FROM setting WHERE key = 'physio_book.from' AND value <> ''), '2026-10-01') AND r.business_date < date('now','localtime') AND COALESCE(r.cash_p,0) + COALESCE(r.upi_p,0) > 0 AND (COALESCE(r.cash_p,0) <> (SELECT COALESCE(SUM(s.amount_p),0) FROM physio_session s JOIN physio_course c ON c.id = s.course_id WHERE c.kind = 'clinic' AND s.day = r.business_date AND s.voided_at = '' AND s.mode = 'cash') OR COALESCE(r.upi_p,0) <> (SELECT COALESCE(SUM(s.amount_p),0) FROM physio_session s JOIN physio_course c ON c.id = s.course_id WHERE c.kind = 'clinic' AND s.day = r.business_date AND s.voided_at = '' AND s.mode = 'upi'))",
   "ok_hi": "Physio slips: register reception ke hisaab se mil raha hai"
  },
