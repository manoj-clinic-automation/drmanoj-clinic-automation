  {
   "id": "darpan.home_meds",
   "person": "darpan",
   "kind": "sql",
   "group": "month",
   "allowed_days": 7,
   "single": true,
   "hi": "Home medicines — ginti",
   "how_hi": "Mahine ke aakhri hafte se: ghar mein kitni bachi hai, likhiye. Kitni mangwani hai, system bata dega.",
   "en": "Darpan: the home medicines count for the coming month is not saved yet (due since {since})",
   "tile": "Home medicines",
   "door": "/finance/monthjobs/home",
   "sql": "WITH t(d) AS (SELECT date('now','localtime')), x(m) AS (SELECT strftime('%Y-%m', date((SELECT d FROM t), '+7 days'))), f(m) AS (SELECT COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'home.floor' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '2026-11')) SELECT CASE WHEN (SELECT m FROM x) >= (SELECT m FROM f) AND EXISTS (SELECT 1 FROM mj_home_item i WHERE i.active = 1) AND NOT EXISTS (SELECT 1 FROM mj_home_count c WHERE c.month = (SELECT m FROM x)) THEN 1 ELSE 0 END AS n, date((SELECT m FROM x) || '-01', '-7 days') AS since",
   "ok_hi": "Home medicines: is mahine ki ginti ho gayi"
  },
  {
   "id": "darpan.vehicle_check",
   "person": "darpan",
   "kind": "sql",
   "group": "month",
   "allowed_days": 3,
   "single": true,
   "hi": "Gaadi ki jaanch — kaagaz, stepney, jack aur paana",
   "how_hi": "Har gaadi mein dekhiye: kaagaz hain? Stepney, jack aur paana? Jo nahi mila, us par Nahi dabaiye, phir Save.",
   "en": "Darpan: the vehicle check of the month ending {since} is not saved yet",
   "tile": "Gaadi ki jaanch",
   "door": "/finance/monthjobs/gaadi",
   "sql": "WITH t(d) AS (SELECT date('now','localtime')), x(m) AS (SELECT strftime('%Y-%m', date((SELECT d FROM t), '+1 day', 'start of month', '-1 day'))), f(m) AS (SELECT COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'vehicle.floor' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '2026-10')) SELECT CASE WHEN (SELECT m FROM x) >= (SELECT m FROM f) AND EXISTS (SELECT 1 FROM mj_vehicle v WHERE v.active = 1) AND NOT EXISTS (SELECT 1 FROM mj_vehicle_check c WHERE c.month = (SELECT m FROM x)) THEN 1 ELSE 0 END AS n, date((SELECT m FROM x) || '-01', '+1 month', '-1 day') AS since",
   "ok_hi": "Gaadi ki jaanch: is mahine ki ho gayi"
  },
  {
   "id": "darpan.expiry_clear",
   "person": "darpan",
   "kind": "sql",
   "group": "month",
   "allowed_days": 7,
   "hi": "Expiry ki safai",
   "how_hi": "Expiry wali dawai shelf se hataiye — har ek par likhiye: supplier ko wapas, ya nasht kiya (shelf par na mile to woh bhi).",
   "en": "Darpan: {n} expired medicine line(s) of the newest expiry list without an outcome (month end {since})",
   "tile": "Expiry ki safai",
   "door": "/finance/monthjobs/expiry",
   "sql": "WITH t(d) AS (SELECT date('now','localtime')), x(m) AS (SELECT strftime('%Y-%m', date((SELECT d FROM t), '+1 day', 'start of month', '-1 day'))), f(m) AS (SELECT COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'expiry.floor' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '2026-10')), r(id) AS (SELECT MAX(id) FROM stock_expiry_run WHERE ok = 1) SELECT CASE WHEN (SELECT m FROM x) >= (SELECT m FROM f) THEN (SELECT COUNT(*) FROM stock_expiry_line l WHERE l.run_id = (SELECT id FROM r) AND l.section = 'expired' AND COALESCE(l.units, 0) > 0 AND substr(COALESCE(l.expiry, ''), 1, 7) <= (SELECT m FROM x) AND NOT EXISTS (SELECT 1 FROM mj_expiry_outcome o WHERE o.k20 = COALESCE(l.k20, '') AND o.batch = COALESCE(l.batch, '') AND o.expiry = COALESCE(l.expiry, ''))) ELSE 0 END AS n, date((SELECT m FROM x) || '-01', '+1 month', '-1 day') AS since",
   "ok_hi": "Expiry ki safai: har dawai ka faisla likha hai"
  },
  {
   "id": "darpan.paper_renewal",
   "person": "darpan",
   "kind": "sql",
   "group": "comeup",
   "allowed_days": 0,
   "hi": "Kaagaz ki yaad",
   "how_hi": "Kholiye: kis gaadi ka kaun sa kaagaz kab khatm ho raha hai. Naya kaagaz banwa kar Dr Manoj ko dijiye — nayi date likhne tak yeh line rahegi.",
   "en": "Vehicle papers to renew: {n} (the first reminder from {since})",
   "tile": "Kaagaz ki yaad",
   "door": "/finance/monthjobs/kaagaz",
   "sql": "WITH t(d) AS (SELECT date('now','localtime')), ld(paper, md) AS (SELECT 'pollution', COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'lead.pollution' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '-7 days') UNION ALL SELECT 'insurance', COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'lead.insurance' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '-1 month') UNION ALL SELECT 'rc', COALESCE((SELECT s.value FROM mj_setting s WHERE s.key = 'lead.rc' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '-45 days')), cur(rd) AS (SELECT CASE WHEN ld.md LIKE '%month%' THEN MIN(date(p.expiry, ld.md), date(p.expiry, 'start of month', ld.md, '+1 month', '-1 day')) ELSE date(p.expiry, ld.md) END FROM mj_paper p JOIN ld ON ld.paper = p.paper JOIN mj_vehicle v ON v.id = p.vehicle_id AND v.active = 1 WHERE p.id = (SELECT MAX(q.id) FROM mj_paper q WHERE q.vehicle_id = p.vehicle_id AND q.paper = p.paper) AND p.expiry <> '') SELECT COUNT(*) AS n, MIN(rd) AS since FROM cur WHERE rd IS NOT NULL AND rd <= (SELECT d FROM t)",
   "ok_hi": "Kaagaz ki yaad: koi kaagaz khatm nahin ho raha"
  },
  {
   "id": "reception.xray_film_count",
   "person": "alisha",
   "kind": "sql",
   "group": "first",
   "allowed_days": 0,
   "single": true,
   "hi": "X-ray film: machine mein kitni film bachi hain, likhiye (dono size)",
   "how_hi": "Machine ki screen par jitni film bachi dikh rahi hain, wahi likhiye — 8×10 aur 11×14 dono, phir Save. Farq ka koi kaaran nahi poochha jaata.",
   "en": "Reception: the X-ray film count of {since} is not saved yet",
   "tile": "X-ray film",
   "door": "/finance/slips/film/subah",
   "sql": "WITH t(ts) AS (SELECT datetime('now','localtime')), d(day) AS (SELECT date((SELECT ts FROM t))) SELECT CASE WHEN (SELECT day FROM d) >= COALESCE((SELECT s.value FROM xf_setting s WHERE s.key = 'count.from' AND s.value <> '' ORDER BY s.id DESC LIMIT 1), '2026-11-01') AND strftime('%w', (SELECT day FROM d)) <> '0' AND (SELECT COUNT(DISTINCT c.size) FROM xf_count c WHERE c.day = (SELECT day FROM d) AND c.void = 0 AND c.id = (SELECT MAX(q.id) FROM xf_count q WHERE q.size = c.size AND q.day = c.day)) < 2 THEN 1 ELSE 0 END AS n, (SELECT day FROM d) AS since",
