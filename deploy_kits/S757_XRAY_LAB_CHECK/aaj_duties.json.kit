   ],
   "kind": "sql",
   "group": "night",
   "allowed_days": 9,
   "soft": true,
   "hi": "Jaane se pehle: aaj ka counter sheet bhariye (cash / UPI / card)",
   "how_hi": "Raat ko rah jaaye to kal subah bhar dijiye.",
   "en": "Tonight: today's counter sheet not filled yet",
   "tile": "Docterz daily collection",
   "door": "/finance/clinic/register",
   "sql": "SELECT CASE WHEN strftime('%H','now','localtime') >= '19' AND strftime('%w','now','localtime') <> '0' AND NOT EXISTS (SELECT 1 FROM clinic_register_day g WHERE g.business_date = date('now','localtime')) THEN 1 ELSE 0 END AS n, date('now','localtime') AS since",
   "single": true,
   "ok_hi": "Aaj ka counter sheet: raat 7 baje ke baad yahan dikhega agar baaki hua"
  },
