    b = _body()
    ok, res, code = start(con, str(b.get("section") or "Orthotics"), _who(u), bool(b.get("override")), own)
    return jsonify(ok=True, **res) if ok else _refuse(res, code)


@bp.route(P + "/api/save", methods=["POST"])
