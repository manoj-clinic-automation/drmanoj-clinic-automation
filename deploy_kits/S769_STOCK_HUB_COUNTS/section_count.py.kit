@bp.route(P + "/api/to_amir", methods=["POST"])
def api_to_amir():
    u, con, own, err = _auth()
    if err:
        return err
    if not own:
        return _refuse("Only the doctor sends the correction to Amir.", 403)
    c = count_row(con, _cid(_body()))
    if not c:
        return _refuse("No such count.", 404)
    ok, res, code = to_amir(con, c, _who(u))
    return jsonify(ok=True, **res) if ok else _refuse(res, code)


@bp.route(P + "/api/cancel", methods=["POST"])
def api_cancel():
    u, con, own, err = _auth()
    if err:
        return err
    if not own:
        return _refuse("Only the doctor cancels a count.", 403)
    c = count_row(con, _cid(_body()))
    if not c or c["status"] not in ("draft", "sent"):
        return _refuse("Only an open or sent count can be cancelled.", 409)
    if not (con.execute("UPDATE section_count SET status='cancelled', cancelled_at=?, cancelled_by=? WHERE id=? AND status IN ('draft','sent')",
                        (now_iso(), _who(u), c["id"])).rowcount or 0):
        con.rollback()
        return _refuse("It changed a moment ago -- reload.", 409)
    audit(con, c["id"], "cancel", dict(was=c["status"]), _who(u))
    con.commit()
    return jsonify(ok=True)


@bp.route(P + "/api/flag", methods=["POST"])
def api_flag():
    u, con, own, err = _auth()
    if err:
        return err
    if not own:
        return _refuse("Only the doctor marks lines.", 403)
    b = _body()
    sec, item = str(b.get("section") or ""), str(b.get("item") or "").strip()
    try:
        lv = int(b.get("level"))
    except (TypeError, ValueError):
        lv = -1
    if sec not in _sm().SECTIONS or not item or lv not in (0, 1, 2):
        return _refuse("section, item and level 0, 1 or 2.", 400)
    con.execute("INSERT INTO section_count_flag (section, item_key, item, level, why, by_user, at) VALUES (?,?,?,?,?,?,?) "
                "ON CONFLICT(section, item_key) DO UPDATE SET level=excluded.level, why=excluded.why, by_user=excluded.by_user, at=excluded.at",
                (sec, nk(item), item, lv, "your mark", _who(u), now_iso()))
    audit(con, None, "flag", dict(section=sec, item=item, level=lv), _who(u))
    con.commit()
    return jsonify(ok=True, note="From the next count.")


@bp.route(P + "/api/aside_clear", methods=["POST"])
def api_aside_clear():
    """The doctor settles a kept-aside line: {count, seq, same_day: true|false, n}. same_day = its bill entered Marg on the count day,
    so Marg's closing holds those boxes: they are added to line n's count. false = entered later: nothing to add."""
    u, con, own, err = _auth()
    if err:
        return err
    if not own:
        return _refuse("Only the doctor settles a kept-aside line.", 403)
    b = _body()
    c = count_row(con, _cid(b))
    if not c or c["status"] != "sent":
        return _refuse("Only a sent count's kept-aside lines are settled here.", 409)
    try:
        seq = int(b.get("seq"))
    except (TypeError, ValueError):
        return _refuse("Which line?", 400)
    same = bool(b.get("same_day"))
    n = None
    if same:
        try:
            n = int(b.get("n"))
        except (TypeError, ValueError):
            return _refuse("Its bill entered Marg on the count day: name the count line (#) the boxes belong to.", 400)
        if not con.execute("SELECT 1 FROM section_count_line WHERE count_id=? AND n=?", (c["id"], n)).fetchone():
            return _refuse("There is no line #%d in this count." % n, 400)
    k = con.execute("UPDATE section_count_extra SET cleared_at=?, cleared_by=?, same_day=?, add_to_n=? WHERE count_id=? AND kind='aside' AND seq=? "
                    "AND cleared_at IS NULL AND (SELECT status FROM section_count WHERE id=?)='sent'",
                    (now_iso(), _who(u), 1 if same else 0, n, c["id"], seq, c["id"])).rowcount or 0
    audit(con, c["id"], "aside_clear", dict(seq=seq, same_day=same, n=n), _who(u))
    con.commit()
    return jsonify(ok=True, cleared=k)


@bp.route(P + "/api/hand", methods=["POST"])
def api_hand():
    """The doctor settles a 'by hand' line: {count, n, change: int} or {count, n, skip: true}; {count, n, clear: true} undoes."""
    u, con, own, err = _auth()
    if err:
        return err
    if not own:
        return _refuse("Only the doctor sets a line by hand.", 403)
    b = _body()
    c = count_row(con, _cid(b))
    if not c or c["status"] != "sent":
        return _refuse("Only a sent count, before it goes to Amir.", 409)
    try:
        n = int(b.get("n"))
    except (TypeError, ValueError):
        return _refuse("Which line?", 400)
    if b.get("clear"):
        ch, sk = None, None
    elif b.get("skip"):
        ch, sk = None, 1
    else:
        try:
            ch, sk = int(b.get("change")), None
        except (TypeError, ValueError):
            return _refuse("The change is a whole number: + more in Marg, - less.", 400)
        if abs(ch) > 999:
            return _refuse("That change is too large to be right.", 400)
    k = con.execute("UPDATE section_count_line SET owner_change=?, owner_skip=? WHERE count_id=? AND n=? AND (SELECT status FROM section_count WHERE id=?)='sent'",
                    (ch, sk, c["id"], n, c["id"])).rowcount or 0
    if not k:
        con.rollback()
        return _refuse("No line #%d in a count still open for changes." % n, 409)
    audit(con, c["id"], "hand", dict(n=n, change=ch, skip=bool(sk)), _who(u))
    con.commit()
    return jsonify(ok=True)
