{
 "_README": [
  "Signature registry for the Marg Report Router. ADDING A NEW REPORT TYPE IS A",
  "DATA EDIT HERE -- no code change. Run 'marg_router.py --learn <file>' on a",
  "sample and it prints a ready-to-paste block.",
  "",
  "Matching rule: title_regex AND header must BOTH match, else the file is",
  "refused (a partial match is never parsed). Unknown files are quarantined,",
  "never guessed at.",
  "",
  "Fields:",
  "  type          short code, becomes the archive folder name",
  "  variant       distinguishes layouts of the same report (DETAIL vs SUMMARY1)",
  "  title_regex   matched against the title row (case-insensitive)",
  "  header        expected column headers, in order; matched as a prefix",
  "  deep_verify   'marg_report' = full arithmetic+truncation check (sale only)",
  "                'structural'  = title/header/date agreement + clean end",
  "  uploadable    true = a VERIFIED file is copied to the Outbox for sending",
  "  end_marker    optional text that must appear near the end (completeness)"
 ],
 "signatures": [
  {
   "type": "SALE_BILLWISE",
   "variant": "DETAIL",
   "title_regex": "BILL\\s+WISE\\s+SALES\\s+STATEMENT",
   "header": [
    "BILL NO.",
    "DESCRIPTION",
    "D.R.",
    "GROSS AMT.",
    "DISCOUNT",
    "TAX",
    "DR/CR",
    "NET AMT.",
    "CASH"
   ],
   "deep_verify": "marg_report",
   "uploadable": true,
   "end_marker": "GRAND TOTAL"
  },
  {
   "type": "SALE_BILLWISE",
   "variant": "SUMMARY1",
   "title_regex": "BILL\\s+WISE\\s+SALES\\s+STATEMENT",
   "header": [
    "BILL NO.",
    "DESCRIPTION",
    "BILL VALUE"
   ],
   "deep_verify": "structural",
   "uploadable": false,
   "note": "3-column variant: NO CASH column, so cash/UPI cannot be derived. Archived, never uploaded."
