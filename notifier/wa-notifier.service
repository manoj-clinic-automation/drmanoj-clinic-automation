[Unit]
Description=WhatsApp -> ntfy notifier (read-only watcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/wa
# S231/F-358: the ntfy topic is a SECRET. This file is PUBLIC.
# It lives only in /root/wa/.env on the box. Never put it here.
EnvironmentFile=/root/wa/.env
Environment=POLL_SECONDS=30
Environment=PAT_REFRESH_MIN=30
ExecStart=/root/wa/venv/bin/python /root/wa/notifier_wa.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
